{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/campaign/*": ["./src/features/campaign/*"],
      "@/crmContacts/*": ["./src/features/crm/contact-details/*"],
      "@/crm/*": ["./src/features/crm/*"],
      "@/dashboard/*": ["./src/features/dashboard/*"],
      "@/emails/*": ["./src/features/channels/emails/*"],
      "@/linkedin/*": ["./src/features/channels/linkedin/*"],
      "@/channels/*": ["./src/features/channels/*"],
      "@/*": ["./src/*"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
